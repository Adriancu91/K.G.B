{
  "manifest_format": 1,
  "id": "kgb.notes",
  "name": "Note",
  "description": "Caietul de note: notițe cu text, liste de bifat, poze, secțiuni și caiete, coș, căutare. Fiecare notă se păstrează separat, deci se sincronizează între PC-uri fără să se piardă ce ai scris pe celălalt.",
  "version": "0.1.0",
  "core": ">=0.1.0, <0.2.0",
  "status": "beta",
  "permissions": [
    "storage.own",
    "files.own"
  ],
  "services": [
    "storage",
    "log",
    "files"
  ],
  "data_types": [
    {
      "collection": "notes",
      "description": "notele: text, data creării și a ultimei modificări",
      "schema": {
        "fields": {
          "text": {
            "type": "string",
            "required": true,
            "max_len": 2000
          },
          "created_ms": {
            "type": "integer",
            "required": true,
            "min": 0
          },
          "updated_ms": {
            "type": "integer",
            "required": true,
            "min": 0
          }
        },
        "additional": false
      }
    },
    {
      "collection": "pages",
      "description": "notițele ferestrei Note: o notiță pe înregistrare (fără pozele mari), data ultimei schimbări, coșul, locul în listă",
      "schema": {
        "fields": {
          "note": {
            "type": "object",
            "required": true
          },
          "updated_ms": {
            "type": "integer",
            "required": true,
            "min": 0
          },
          "trashed": {
            "type": "bool",
            "required": true
          },
          "idx": {
            "type": "integer",
            "required": true,
            "min": 0
          }
        },
        "additional": false
      }
    },
    {
      "collection": "notebook",
      "description": "caietul: secțiunile, culorile, grupurile, caietele și harta pozelor păstrate ca fișiere",
      "schema": {
        "fields": {
          "meta": {
            "type": "object",
            "required": true
          },
          "images": {
            "type": "object",
            "required": true
          }
        },
        "additional": false
      }
    }
  ],
  "events": {
    "emits": [],
    "listens": []
  },
  "data_format": 1,
  "migrations": [],
  "on_disable": "Notele, caietele și pozele lor rămân salvate în spațiul de lucru și reapar când modulul este activat din nou."
}
